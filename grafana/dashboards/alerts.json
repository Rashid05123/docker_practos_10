{
  "uid": "pr10-alerts",
  "title": "ПР10 Мониторинг и алерты",
  "timezone": "browser",
  "schemaVersion": 42,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "annotations": {
    "list": [
      {"name": "SportLine Firing", "enable": true, "iconColor": "red", "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "expr": "ALERTS{alertname=\"SportLineNoRequests\",alertstate=\"firing\"}", "step": "5s", "titleFormat": "Firing", "textFormat": "SportLineNoRequests", "filter": {"exclude": false, "ids": [1]}},
      {"name": "SportLine Resolved", "enable": true, "iconColor": "green", "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "expr": "max_over_time(ALERTS{alertname=\"SportLineNoRequests\",alertstate=\"firing\"}[15s]) unless ALERTS{alertname=\"SportLineNoRequests\",alertstate=\"firing\"}", "step": "5s", "titleFormat": "Resolved", "textFormat": "SportLineNoRequests", "filter": {"exclude": false, "ids": [1]}},
      {"name": "CPU Firing", "enable": true, "iconColor": "red", "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "expr": "ALERTS{alertname=\"HighWindowsCpu\",alertstate=\"firing\"}", "step": "5s", "titleFormat": "Firing", "textFormat": "HighWindowsCpu", "filter": {"exclude": false, "ids": [2]}},
      {"name": "CPU Resolved", "enable": true, "iconColor": "green", "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "expr": "max_over_time(ALERTS{alertname=\"HighWindowsCpu\",alertstate=\"firing\"}[15s]) unless ALERTS{alertname=\"HighWindowsCpu\",alertstate=\"firing\"}", "step": "5s", "titleFormat": "Resolved", "textFormat": "HighWindowsCpu", "filter": {"exclude": false, "ids": [2]}}
    ]
  },
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Приложение SportLine: запросов за минуту", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 10}, "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "targets": [{"expr": "sum(increase(sportline_http_requests_total{group=\"application\"}[1m]))", "legendFormat": "Запросов за минуту"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "Компьютер Windows: загрузка процессора", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 10}, "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "targets": [{"expr": "windows_cpu_usage_percent{group=\"computer\"}", "legendFormat": "CPU"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 80}]}}, "overrides": []}},
    {"id": 4, "type": "state-timeline", "title": "Статусы алертов", "gridPos": {"x": 0, "y": 10, "w": 24, "h": 6}, "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "targets": [{"refId": "A", "expr": "(2 * max(ALERTS{alertname=\"SportLineNoRequests\",alertstate=\"firing\"})) or max(ALERTS{alertname=\"SportLineNoRequests\",alertstate=\"pending\"}) or on() vector(0)", "legendFormat": "SportLineNoRequests"}, {"refId": "B", "expr": "(2 * max(ALERTS{alertname=\"HighWindowsCpu\",alertstate=\"firing\"})) or max(ALERTS{alertname=\"HighWindowsCpu\",alertstate=\"pending\"}) or on() vector(0)", "legendFormat": "HighWindowsCpu"}], "options": {"mergeValues": true, "showValue": "auto", "rowHeight": 0.8, "alignValue": "center", "legend": {"showLegend": false}}, "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}, "mappings": [{"type": "value", "options": {"0": {"text": "Resolved", "color": "green", "index": 0}, "1": {"text": "Pending", "color": "yellow", "index": 1}, "2": {"text": "Firing", "color": "red", "index": 2}}}]}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Доступность приложения", "gridPos": {"x": 0, "y": 16, "w": 24, "h": 6}, "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "targets": [{"expr": "up{job=\"sportline\",group=\"application\"}", "legendFormat": "SportLine"}], "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}}
  ]
}
