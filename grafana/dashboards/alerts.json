{
  "uid": "pr10-alerts",
  "title": "ПР10 Мониторинг и алерты",
  "timezone": "browser",
  "schemaVersion": 42,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Приложение SportLine: число запросов", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 9}, "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "targets": [{"expr": "sum(sportline_http_requests_total{group=\"application\"})", "legendFormat": "Запросы"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "Компьютер Windows: загрузка процессора", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 9}, "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "targets": [{"expr": "windows_cpu_usage_percent{group=\"computer\"}", "legendFormat": "CPU"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Доступность приложения", "gridPos": {"x": 0, "y": 9, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "targets": [{"expr": "up{job=\"sportline\",group=\"application\"}", "legendFormat": "SportLine"}], "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "Состояние алертов", "gridPos": {"x": 12, "y": 9, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "pr10-prometheus"}, "targets": [{"expr": "ALERTS{alertstate=\"firing\"}", "legendFormat": "{{alertname}}"}], "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}}
  ]
}
